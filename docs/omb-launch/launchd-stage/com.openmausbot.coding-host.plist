	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/Users/julen/Library/Logs/openmausbot/coding-host.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/julen/Library/Logs/openmausbot/coding-host.err.log</string>
</dict>
