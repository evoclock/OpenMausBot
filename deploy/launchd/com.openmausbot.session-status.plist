<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace every __PLACEHOLDER__ before loading. See docs/session-status-feed.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmausbot.session-status</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__REPO_ROOT__/scripts/session-status-report.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OMB_URL</key>
    <string>__OMB_URL__</string>
    <key>OMB_SESSION_STATUS_DIR</key>
    <string>__STATUS_DIR__</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/openmausbot-session-status.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/openmausbot-session-status.log</string>
</dict>
</plist>
